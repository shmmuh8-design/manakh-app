  })();


  // ---------- horizontal tabs: tap or swipe between sections of one page ----------
  (function(){
    function setup(sec){
      const tabs = [...sec.querySelectorAll('.tab')];
      const panes = sec.querySelector('.panes');
      const list = [...panes.children];
      const names = list.map(p => p.dataset.pane);
      let active = null;
      function emit(){ document.dispatchEvent(new CustomEvent('tabchange', { detail:{ page:sec.id, tab:active } })); }
      function go(n){
        if(!names.includes(n)) return;
        const back = active && names.indexOf(n) < names.indexOf(active);
        const changed = n !== active;
        active = n;
        list.forEach(p => {
          const on = p.dataset.pane === n;
          p.classList.toggle('on', on);
          p.classList.toggle('from-left', on && back);
        });
        tabs.forEach(t => { const on = t.dataset.tab === n; t.classList.toggle('on', on); t.setAttribute('aria-selected', on); if(on) t.scrollIntoView({ block:'nearest', inline:'nearest' }); });
        const top = sec.querySelector('.tabs').getBoundingClientRect().top;
        if(changed && top < 0) window.scrollBy({ top: top - 8, behavior:'instant' });
        if(changed && sec.classList.contains('active')) emit();
      }
      tabs.forEach(t => t.addEventListener('click', () => go(t.dataset.tab)));
      // swipe (RTL: swipe left = next tab). Ignore swipes that start on the map or a slider.
      let sx = 0, sy = 0, track = false;
      panes.addEventListener('touchstart', e => {
        const t = e.target;
        track = !(t.closest('#wxMap') || t.closest('input[type=range]') || t.closest('.qibla-stage') || t.closest('.map-chips'));
        sx = e.touches[0].clientX; sy = e.touches[0].clientY;
      }, { passive:true });
      panes.addEventListener('touchend', e => {
        if(!track) return;
        const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
        if(Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.6) return;
        const i = names.indexOf(active);
        const next = dx < 0 ? i + 1 : i - 1;
        if(next >= 0 && next < names.length) go(names[next]);
      }, { passive:true });
      go(names[0]);
      sec._tabs = { go, fit(){}, emit, current: () => active };
    }
    document.querySelectorAll('section.tabbed').forEach(setup);

    // page switching knows about tabs; old page names still work ("page-map" opens the map tab, etc.)
    const ALIAS = { 'page-map':'page-weather:map', 'page-qibla':'page-prayer:qibla', 'page-anwaa':'page-seasons:anwaa', 'page-zodiac-guide':'page-seasons:zodiac' };
    const prevShow = showPage;
    showPage = function(id){
      id = ALIAS[id] || id;
      const [pid, tab] = id.split(':');
      prevShow(pid);
      const sec = document.getElementById(pid);
      requestAnimationFrame(() => {
        if(sec && sec._tabs){
          if(tab && tab !== sec._tabs.current()) sec._tabs.go(tab);
          else sec._tabs.emit();
        } else {
          document.dispatchEvent(new CustomEvent('tabchange', { detail:{ page:pid, tab:null } }));
        }
      });
    };
    window.showPage = showPage;
  })();


