  // ---------- alert tones: synthesised sounds, one per alert kind ----------
  const TONES = {
    storm:     'صاعقة ورعد',
    lightning: 'برق',
    siren:     'إنذار متصاعد',
    rain:      'قطرات المطر',
    bell:      'جرس',
    chime:     'لحن هادئ',
    beep:      'تن-تن'
  };
  const toneDefaults = { thunder:'storm', rain:'rain', general:'bell', vol:90 };
  const toneCfg = (function(){ try{ return Object.assign({}, toneDefaults, JSON.parse(localStorage.getItem('manakh_tones') || '{}')); }catch(e){ return Object.assign({}, toneDefaults); } })();
  function toneSave(){ try{ localStorage.setItem('manakh_tones', JSON.stringify(toneCfg)); }catch(e){} }

  function toneOut(){
    const ctx = audioCtx;
    const master = ctx.createGain(); master.gain.value = (toneCfg.vol / 100) * 1.4;
    const comp = ctx.createDynamicsCompressor();
    comp.threshold.value = -18; comp.knee.value = 8; comp.ratio.value = 6; comp.attack.value = 0.003; comp.release.value = 0.2;
    master.connect(comp); comp.connect(ctx.destination);
    return master;
  }
  function toneNoise(sec){
    const ctx = audioCtx, len = Math.floor(ctx.sampleRate * sec), buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0);
    for(let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource(); src.buffer = buf; return src;
  }
  function toneEnv(g, t, peak, a, dcy){
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(peak, t + a);
    g.gain.exponentialRampToValueAtTime(0.0001, t + a + dcy);
  }
  function toneOsc(out, type, f, t, a, dcy, peak, fEnd){
    const ctx = audioCtx, o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type; o.frequency.setValueAtTime(f, t);
    if(fEnd) o.frequency.exponentialRampToValueAtTime(fEnd, t + a + dcy);
    toneEnv(g, t, peak, a, dcy); o.connect(g); g.connect(out); o.start(t); o.stop(t + a + dcy + 0.05);
  }
  function toneCrack(out, t, peak){
    const ctx = audioCtx, n = toneNoise(0.3), hp = ctx.createBiquadFilter(), g = ctx.createGain();
    hp.type = 'highpass'; hp.frequency.value = 1400;
    toneEnv(g, t, peak, 0.004, 0.22); n.connect(hp); hp.connect(g); g.connect(out); n.start(t); n.stop(t + 0.3);
  }
  function toneRumble(out, t, dur, peak){
    const ctx = audioCtx, n = toneNoise(dur + 0.2), lp = ctx.createBiquadFilter(), g = ctx.createGain();
    lp.type = 'lowpass'; lp.frequency.setValueAtTime(420, t); lp.frequency.exponentialRampToValueAtTime(90, t + dur);
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(peak, t + 0.25);
    g.gain.setValueAtTime(peak * 0.7, t + dur * 0.45); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    n.connect(lp); lp.connect(g); g.connect(out); n.start(t); n.stop(t + dur + 0.2);
  }
  const TONE_PLAY = {
    storm(out, t){ toneCrack(out, t, 1.2); toneOsc(out, 'sawtooth', 2400, t, 0.003, 0.12, 0.25, 180); toneRumble(out, t + 0.12, 2.6, 1.4); toneCrack(out, t + 1.1, 0.5); return 2.9; },
    lightning(out, t){ [0, 0.28, 0.5].forEach((d, i) => { toneCrack(out, t + d, 1 - i * 0.2); toneOsc(out, 'sawtooth', 3200, t + d, 0.002, 0.14, 0.35, 150); }); return 0.8; },
    siren(out, t){ for(let i = 0; i < 3; i++){ const a = t + i * 0.7; toneOsc(out, 'sawtooth', 560, a, 0.02, 0.62, 0.35, 1500); toneOsc(out, 'square', 560, a, 0.02, 0.62, 0.12, 1500); } return 2.1; },
    rain(out, t){
      const ctx = audioCtx, n = toneNoise(2.2), bp = ctx.createBiquadFilter(), g = ctx.createGain();
      bp.type = 'bandpass'; bp.frequency.value = 2200; bp.Q.value = 0.6;
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.18, t + 0.4); g.gain.exponentialRampToValueAtTime(0.0001, t + 2.1);
      n.connect(bp); bp.connect(g); g.connect(out); n.start(t); n.stop(t + 2.2);
      for(let i = 0; i < 16; i++){ const d = t + 0.1 + Math.random() * 1.8, f = 1500 + Math.random() * 1400; toneOsc(out, 'sine', f, d, 0.003, 0.07, 0.45, f * 0.35); }
      toneOsc(out, 'triangle', 988, t + 0.05, 0.01, 0.5, 0.3); toneOsc(out, 'triangle', 1319, t + 0.3, 0.01, 0.6, 0.3);
      return 2.2;
    },
    bell(out, t){ [0, 0.55, 1.1].forEach(d => [[1, 0.5], [2.76, 0.22], [5.4, 0.1]].forEach(([m, p]) => toneOsc(out, 'sine', 880 * m, t + d, 0.004, 1.1, p))); return 2.2; },
    chime(out, t){ [523, 659, 784, 1047, 784, 1047].forEach((f, i) => toneOsc(out, 'triangle', f, t + i * 0.16, 0.01, 0.55, 0.35)); return 1.6; },
    beep(out, t){ toneOsc(out, 'sine', 880, t, 0.02, 0.33, 0.4); toneOsc(out, 'sine', 660, t + 0.22, 0.02, 0.33, 0.4); return 0.6; }
  };
  function tonePlay(name){
    unlockAudio();
    if(!audioCtx || !TONE_PLAY[name]) return 0;
    try{ if(navigator.audioSession) navigator.audioSession.type = 'playback'; }catch(e){}
    const out = toneOut();
    const dur = TONE_PLAY[name](out, audioCtx.currentTime + 0.03);
    setTimeout(() => { try{ out.disconnect(); if(navigator.audioSession) navigator.audioSession.type = 'auto'; }catch(e){} }, (dur + 0.5) * 1000);
    return dur;
  }
