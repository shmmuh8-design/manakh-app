      if(code <= 2) return isDay ? ['غائمة جزئيًا','🌤️'] : ['غائمة جزئيًا','☁️'];
      if(code === 3) return ['غائمة','☁️'];
      if(code === 45 || code === 48) return ['فيها ضباب','🌫️'];
      if(code >= 51 && code <= 57) return ['فيها رذاذ','🌦️'];
      if((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return ['ممطرة','🌧️'];
      if((code >= 71 && code <= 77) || code === 85 || code === 86) return ['فيها ثلوج','❄️'];
      if(code >= 95) return ['فيها عواصف رعدية','⛈️'];
      return ['', ''];
    }

    function applyCity(c){
      if(!c.live) return;
      state.outdoor = c.t; state.humidity = c.h; state.windDeg = c.deg; state.windSpeed = c.speed;
      state.feels = c.feels; state.uv = c.uv; state.code = c.code;
      const sk = sky(c.code, c.isDay); state.sky = sk[0]; state.skyIcon = sk[1];
      lastNotifiedOutdoor = state.outdoor; lastNotifiedHumidity = state.humidity;
    }

    // selecting a city uses its real reading instead of a random one
    const baseSelect = selectCity;
    selectCity = function(city){
      baseSelect(city);
      if(city.live){ applyCity(city); render(); updateWindUI(); updateUV(); }
    };

    let firstLoad = true;
    async function fetchLive(){
      const lat = list.map(c => coords[c.name][0]).join(',');
      const lon = list.map(c => coords[c.name][1]).join(',');
      const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon +
        '&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,wind_direction_10m,uv_index,weather_code,is_day' +
        '&wind_speed_unit=kmh&timezone=auto';
      try{
        const res = await fetch(url);
        if(!res.ok) throw new Error('HTTP ' + res.status);
        let data = await res.json();
        if(!Array.isArray(data)) data = [data];
        data.forEach((d, i) => {
          const c = list[i], cur = d && d.current;
          if(!c || !cur) return;
          c.t = cur.temperature_2m; c.h = cur.relative_humidity_2m; c.feels = cur.apparent_temperature;
          c.speed = cur.wind_speed_10m; c.deg = cur.wind_direction_10m; c.uv = cur.uv_index;
          c.code = cur.weather_code; c.isDay = cur.is_day === 1; c.live = true;
        });
        const prevT = state.outdoor, prevH = state.humidity;
        applyCity(selectedCityRef);
        if(!firstLoad){ lastNotifiedOutdoor = prevT; lastNotifiedHumidity = prevH; } // let real changes trigger alerts
        liveData = !!selectedCityRef.live;
        render(); updateWindUI(); updateUV();
        const now = new Date();
        document.getElementById('lastUpdate').textContent =
          'آخر تحديث: ' + String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0') +
          ' · بيانات طقس حقيقية من Open-Meteo تتحدث كل 10 دقائق';
        if(document.getElementById('page-cities').classList.contains('active')) renderCitiesList();
      }catch(e){
        if(firstLoad) showToast('تعذّر جلب بيانات الطقس الآن، سنحاول مرة أخرى');
      }
      firstLoad = false;
    }
    fetchLive();
    setInterval(fetchLive, 10 * 60 * 1000);
  })();

  // =====================================================================
  //  خريطة الطقس + الرادار + الرعد والبرق + التنبيهات + بوصلة القبلة
  // =====================================================================
  (function(){
    const $ = id => document.getElementById(id);
    const pad = n => String(n).padStart(2, '0');
    const hhmm = d => pad(d.getHours()) + ':' + pad(d.getMinutes());
    function cityPos(){
      const c = selectedCityRef;
      return (c && typeof c.lat === 'number') ? { lat:c.lat, lon:c.lon, label:c.name } : { lat:23.588, lon:58.383, label:'مسقط' };
    }
    function store(key, val){ try{ localStorage.setItem(key, JSON.stringify(val)); }catch(e){} }
    function load(key, def){ try{ const v = localStorage.getItem(key); return v ? JSON.parse(v) : def; }catch(e){ return def; } }

    // ---------------- page hooks ----------------
    document.addEventListener('tabchange', e => {
      const t = e.detail.tab;
      if(t === 'map') openMap(); else stopRadar();
      if(t === 'qibla') openQibla();
    });

    // ================= WEATHER MAP =================
    let map = null, radarFrames = [], radarIdx = 0, radarTimer = null, radarHost = '';
    let radarGroup = null, thunderGroup = null, showRadar = true, showThunder = true;
    let lastThunderCenter = null, leafletPromise = null, radarLoadedAt = 0;

    function loadLeaflet(){
      if(window.L) return Promise.resolve();
      if(leafletPromise) return leafletPromise;
      const pre = document.querySelector('head script[src*="leaflet.js"]');
      if(pre && !pre.dataset.failed){
        // the page already asked for Leaflet; give it a few seconds before loading a second copy
        leafletPromise = new Promise(resolve => {
          let n = 0; const t = setInterval(() => { if(window.L || ++n > 40){ clearInterval(t); resolve(); } }, 100);
        }).then(() => { if(window.L) return; pre.dataset.failed = '1'; leafletPromise = null; return loadLeaflet(); });
        return leafletPromise;
      }
      leafletPromise = new Promise((resolve, reject) => {
        let left = 2;
        const done = () => { if(--left === 0) resolve(); };
        const fail = () => { leafletPromise = null; reject(new Error('leaflet')); };
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css';
        css.onload = done; css.onerror = fail;
        document.head.appendChild(css);
        const js = document.createElement('script');
        js.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js';
        js.onload = done; js.onerror = fail;
        document.head.appendChild(js);
        setTimeout(() => { if(left > 0 && window.L) resolve(); }, 8000);
      });
      return leafletPromise;
    }
    function setStatus(t){ $('mapStatus').textContent = t; $('mapStatus').style.display = t ? '' : 'none'; }

    async function openMap(){
      try{ await loadLeaflet(); }
      catch(e){ setStatus('تعذّر تحميل مكتبة الخريطة، تأكد من الاتصال بالإنترنت'); return; }
      if(!$('wxMap').offsetWidth){ setTimeout(openMap, 150); return; } // wait until the tab is really visible
      try{ buildMap(); applyOwm(); }catch(e){ setStatus('خطأ في الخريطة: ' + (e && e.message ? e.message : e)); return; }
      [60, 400, 900].forEach(t => setTimeout(() => map.invalidateSize(), t));
      if(Date.now() - radarLoadedAt > 10*60*1000) loadRadar();
      else if(showRadar) playRadar();
      loadThunder();
    }
    function buildMap(){
      const p = cityPos();
      if(!map){
        map = L.map('wxMap', { zoomControl:true, worldCopyJump:true, minZoom:3, maxZoom:11 }).setView([p.lat, p.lon], 6);
        map.createPane('radarPane');   map.getPane('radarPane').style.zIndex = 350;
        map.createPane('thunderPane'); map.getPane('thunderPane').style.zIndex = 420;
        map.createPane('labelsPane');  map.getPane('labelsPane').style.zIndex = 460; map.getPane('labelsPane').style.pointerEvents = 'none';
        // OpenStreetMap tiles (free, no key) darkened with a CSS filter to match the app
        let baseOk = false, baseErr = 0;
        const base = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom:11, className:'osm-dark',
          attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);
        base.on('tileload', () => { baseOk = true; });
        base.on('tileerror', () => {
          if(baseOk || ++baseErr < 4) return;
          baseOk = true;
          map.removeLayer(base);
          L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            maxZoom:11, attribution:'Tiles &copy; Esri'
          }).addTo(map);
        });
        map.attributionControl.addAttribution('Radar: <a href="https://www.rainviewer.com/" target="_blank">RainViewer</a> · Weather: <a href="https://open-meteo.com/" target="_blank">Open-Meteo</a>');
        if(window.ResizeObserver) new ResizeObserver(() => map.invalidateSize()).observe($('wxMap'));
        radarGroup = L.layerGroup().addTo(map);
        thunderGroup = L.layerGroup().addTo(map);
        map.on('moveend', () => {
          const c = map.getCenter();
          if(!lastThunderCenter || Math.abs(c.lat - lastThunderCenter.lat) > 2.5 || Math.abs(c.lng - lastThunderCenter.lng) > 2.5) loadThunder();
        });
      }
    }
    window.addEventListener('error', e => {
      if($('page-weather').classList.contains('active') && $('page-weather')._tabs && $('page-weather')._tabs.current() === 'map')
        setStatus('خطأ: ' + (e.message || 'غير معروف'));
    });

    // ---- radar (RainViewer, last 2 hours) ----
    async function loadRadar(){
      setStatus('جاري تحميل الرادار…');
      try{
        const res = await fetch('https://api.rainviewer.com/public/weather-maps.json');
        const j = await res.json();
        radarHost = j.host;
        radarFrames = ((j.radar && j.radar.past) || []).map(f => ({ time:f.time, path:f.path, layer:null }));
        radarLoadedAt = Date.now();
        radarGroup.clearLayers();
        if(!radarFrames.length){ setStatus('لا توجد بيانات رادار حاليًا'); return; }
        $('radarSlider').max = radarFrames.length - 1;
        showFrame(radarFrames.length - 1);
        setStatus('');
        if(showRadar) playRadar();
      }catch(e){ setStatus('تعذّر تحميل الرادار الآن'); }
    }
    function frameLayer(f){
      if(!f.layer){
        f.layer = L.tileLayer(radarHost + f.path + '/256/{z}/{x}/{y}/2/1_1.png', {
          pane:'radarPane', opacity:0, maxNativeZoom:7, maxZoom:11, tileSize:256
        });
      }
      return f.layer;
    }
    function showFrame(i){
      if(!radarFrames.length) return;
      radarIdx = (i + radarFrames.length) % radarFrames.length;
      radarFrames.forEach((f, k) => {
        if(k === radarIdx){
          const l = frameLayer(f);
          if(showRadar && !radarGroup.hasLayer(l)) radarGroup.addLayer(l);
          l.setOpacity(showRadar ? 0.75 : 0);
        } else if(f.layer){ f.layer.setOpacity(0); }
      });
      // preload the next frame so the animation is smooth
      const nxt = radarFrames[(radarIdx + 1) % radarFrames.length];
      if(showRadar && !radarGroup.hasLayer(frameLayer(nxt))) radarGroup.addLayer(nxt.layer);
      const d = new Date(radarFrames[radarIdx].time * 1000);
      const ago = Math.round((Date.now() - d.getTime()) / 60000);
      $('radarTime').textContent = hhmm(d);
      $('radarTime').title = ago <= 10 ? 'الآن' : ('قبل ' + ago + ' دقيقة');
      $('radarSlider').value = radarIdx;
    }
    function playRadar(){
      stopRadar();
      if(!radarFrames.length) return;
      $('radarPlay').textContent = '❚❚';
      radarTimer = setInterval(() => {
        // pause a little longer on the latest frame
        if(radarIdx === radarFrames.length - 1 && !playRadar._hold){ playRadar._hold = true; return; }
        playRadar._hold = false;
        showFrame(radarIdx + 1);
      }, 650);
    }
    function stopRadar(){ clearInterval(radarTimer); radarTimer = null; $('radarPlay').textContent = '▶'; }
    $('radarPlay').addEventListener('click', () => { radarTimer ? stopRadar() : playRadar(); });
    $('radarSlider').addEventListener('input', e => { stopRadar(); showFrame(+e.target.value); });

    // ---- thunderstorms (Open-Meteo, next 3–4 hours on a grid) ----
    function thunderRisk(h, i){
      const codes = (h.weather_code || []).slice(0, 4);
      const cape = (h.cape || []).slice(0, 4).filter(v => v != null);
      const prob = (h.precipitation_probability || []).slice(0, 4).filter(v => v != null);
      const tIdx = codes.findIndex(c => c >= 95);
      const maxCape = cape.length ? Math.max(...cape) : 0;
      const maxP = prob.length ? Math.max(...prob) : 0;
      if(tIdx >= 0) return { level:3, inH:tIdx, prob:maxP, cape:maxCape };
      if(maxCape >= 1500 && maxP >= 40) return { level:2, prob:maxP, cape:maxCape };
      if(maxCape >= 800 && maxP >= 30) return { level:1, prob:maxP, cape:maxCape };
      return { level:0 };
    }
    async function loadThunder(){
      if(!map || !showThunder) return;
      const c = map.getCenter();
      lastThunderCenter = { lat:c.lat, lng:c.lng };
      const lats = [], lons = [];
      for(let dy = -4; dy <= 4; dy++) for(let dx = -4; dx <= 4; dx++){
        const la = Math.max(-80, Math.min(80, Math.round(c.lat) + dy));
        let lo = Math.round(c.lng) + dx; lo = ((lo + 540) % 360) - 180;
        lats.push(la); lons.push(lo);
      }
      const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + lats.join(',') + '&longitude=' + lons.join(',') +
        '&hourly=weather_code,cape,precipitation_probability&forecast_hours=4&timezone=auto';
      try{
        const res = await fetch(url);
        let data = await res.json();
        if(!Array.isArray(data)) data = [data];
        thunderGroup.clearLayers();
        let storms = 0;
        data.forEach((d, i) => {
          if(!d || !d.hourly) return;
          const r = thunderRisk(d.hourly);
          if(!r.level) return;
          const color = r.level === 3 ? '#ff4d6d' : r.level === 2 ? '#ffb066' : '#ffe27a';
          const txt = r.level === 3
