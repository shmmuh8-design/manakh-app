  // ---------- religious occasions: dates computed every year from the Hijri calendar + live countdown ----------
  (function(){
    const grid = document.getElementById('occGrid'), hero = document.getElementById('occHero');
    if(!grid) return;
    const OCC = [
      { m:1,  d:1,  name:'رأس السنة الهجرية',        emo:'🌙', c:'green'  },
      { m:1,  d:10, name:'يوم عاشوراء',              emo:'🤲', c:'slate'  },
      { m:3,  d:12, name:'المولد النبوي الشريف',      emo:'✨', c:'gold'   },
