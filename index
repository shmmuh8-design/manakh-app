      { m:12, d:10, name:'عيد الأضحى المبارك',        emo:'🐑', c:'amber'  }
    ];
    const HM = ['محرم','صفر','ربيع الأول','ربيع الآخر','جمادى الأولى','جمادى الآخرة','رجب','شعبان','رمضان','شوال','ذو القعدة','ذو الحجة'];
    let cal = 'islamic-umalqura';
    try{ if(new Intl.DateTimeFormat('en-u-ca-' + cal).resolvedOptions().calendar !== cal) cal = 'islamic-civil'; }catch(e){ cal = 'islamic-civil'; }
    let fNum, fTxt, fGreg;
    try{
      fNum = new Intl.DateTimeFormat('en-u-ca-' + cal, { day:'numeric', month:'numeric', year:'numeric' });
      fTxt = new Intl.DateTimeFormat('ar-u-ca-' + cal + '-nu-latn', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
      fGreg = new Intl.DateTimeFormat('ar-u-nu-latn', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
    }catch(e){ return; }
    const hij = d => { const p = {}; fNum.formatToParts(d).forEach(x => p[x.type] = x.value); return { y:parseInt(p.year,10), m:+p.month, d:+p.day }; };

    let items = [], builtFor = '';
    function build(){
      const now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      // walk forward up to ~13 months and pick the first matching day for each occasion
      const found = {};
      for(let i = 0; i < 400 && Object.keys(found).length < OCC.length; i++){
        const day = new Date(today.getFullYear(), today.getMonth(), today.getDate() + i);
        const h = hij(day);
        OCC.forEach((o, k) => { if(!found[k] && h.m === o.m && h.d === o.d) found[k] = { day, h }; });
      }
      items = OCC.map((o, k) => found[k] ? Object.assign({}, o, found[k]) : null).filter(Boolean).sort((a, b) => a.day - b.day);
      document.getElementById('hijriTodayTxt').textContent = fTxt.format(today);
      builtFor = today.toDateString();
      render();
    }
    const pad = n => String(n).padStart(2, '0');
    function parts(ms){ ms = Math.max(0, ms); const s = Math.floor(ms / 1000); return { d:Math.floor(s / 86400), h:Math.floor(s % 86400 / 3600), m:Math.floor(s % 3600 / 60), s:s % 60 }; }
    const isToday = it => it.day.toDateString() === new Date().toDateString();
    const hLabel = it => (it.night ? 'ليلة ' : '') + it.h.d + ' ' + HM[it.h.m - 1] + ' ' + it.h.y + ' هـ';

    function render(){
      if(!items.length){ hero.innerHTML = '<div class="oh-name">تعذّر حساب التواريخ على هذا الجهاز</div>'; return; }
      const f = items[0];
      hero.classList.toggle('today', isToday(f));
      hero.innerHTML = `<span class="oh-tag">${isToday(f) ? 'مناسبة اليوم' : 'أقرب مناسبة'}</span>
        <div class="oh-emoji">${f.emo}</div><div class="oh-name">${f.name}</div>
        <div class="oh-date">${hLabel(f)} · ${fGreg.format(f.day)}</div>` +
        (isToday(f) ? `<div class="oh-today">🎉 اليوم — كل عام وأنتم بخير</div>`
          : `<div class="oh-count"><div><b id="ohD">0</b><span>يوم</span></div><div><b id="ohH">00</b><span>ساعة</span></div><div><b id="ohM">00</b><span>دقيقة</span></div><div><b id="ohS">00</b><span>ثانية</span></div></div>`);
      grid.innerHTML = items.slice(1).map((it, k) => `
        <div class="card occ-card${isToday(it) ? ' is-today' : ''}">
          <div class="icon3d ${it.c}"><span class="emo">${it.emo}</span></div>
          <div class="num" data-k="${k + 1}">—</div>
          <div class="tick" data-t="${k + 1}"></div>
          <div class="lbl2">${it.name}</div>
          <div class="hdate">${hLabel(it)}</div>
          <div class="date">${fGreg.format(it.day)}</div>
        </div>`).join('');
      tick();
    }
    function tick(){
      if(new Date().toDateString() !== builtFor){ build(); return; } // a new day: recompute
      const now = Date.now();
      if(items[0] && !isToday(items[0])){
        const p = parts(items[0].day - now);
        const set = (id, v) => { const el = document.getElementById(id); if(el) el.textContent = v; };
        set('ohD', p.d); set('ohH', pad(p.h)); set('ohM', pad(p.m)); set('ohS', pad(p.s));
      }
      grid.querySelectorAll('.num').forEach(el => {
        const it = items[+el.dataset.k];
        if(isToday(it)){ el.textContent = '🎉 اليوم'; return; }
        const p = parts(it.day - now);
        el.textContent = p.d + ' يوم';
        const t = grid.querySelector(`.tick[data-t="${el.dataset.k}"]`);
        if(t) t.textContent = pad(p.h) + ':' + pad(p.m) + ':' + pad(p.s);
      });
    }
    build();
    setInterval(() => { const sec = document.getElementById('page-prayer'); if(sec && sec.classList.contains('active')) tick(); }, 1000);
    document.addEventListener('tabchange', e => { if(e.detail.tab === 'occ') tick(); });
  })();


