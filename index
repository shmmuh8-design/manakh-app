      const h = new Date().getHours();
      return (h >= 6 && h <= 18) ? Math.max(0, Math.round(9 * Math.sin(Math.PI * (h-6)/12))) : 0;
    }
    function currentAnwaa(){
      try{
        const now = new Date();
        let cur = null;
        anwaaData.forEach(a => { if(inRange(now, a.start, a.end)) cur = a; });
        return cur;
      }catch(e){ return null; }
    }

    function build(){
      const city = selectedCityRef.name;
      const c = state.outdoor;
      const u = unitSymbol();
      const t = Math.round(cTo(c));
      const feel = Math.round(cTo(typeof state.feels==='number' ? state.feels : c + 6));
      const h = Math.round(state.humidity);
      const ws = Math.round(state.windSpeed);
      const dir = windDirLabel(state.windDeg);
      const hr = new Date().getHours();
      const greet = (hr >= 5 && hr < 12) ? 'صباح الخير' : 'مساء الخير';
      const uv = currentUV();

      let advice;
      if(typeof state.code==='number' && state.code >= 95) advice = 'فيه عواصف رعدية، ابتعدوا عن الأودية والأماكن المكشوفة.';
      else if(typeof state.code==='number' && ((state.code >= 51 && state.code <= 67) || (state.code >= 80 && state.code <= 82))) advice = 'فيه أمطار، انتبهوا في الطرق وابتعدوا عن مجاري الأودية.';
      else if(c >= 40) advice = 'الحر شديد اليوم، اشربوا ماء كثير وتجنّبوا الشمس من الظهر إلى العصر.';
      else if(h >= 75) advice = 'الرطوبة عالية، خفّفوا المجهود في الخارج وخلّوا المكيّف على درجة معتدلة.';
      else if(uv >= 6) advice = 'الأشعة فوق البنفسجية قوية الحين، لا تنسون واقي الشمس والنظارة.';
      else if(state.windSpeed >= 30) advice = 'الرياح قوية، انتبهوا من الغبار وأغلقوا النوافذ.';
      else if(c < 15) advice = 'الجو بارد، البسوا شي دافي إذا طلعتوا.';
      else advice = 'الجو مناسب للطلعات والمشي، استمتعوا بيومكم.';

      const out = [
        `${greet}! معكم مزنة من <b>${city}</b>. الحرارة الآن <b dir="ltr">${t}${u}</b> والجو ${tempWord(c)}${state.sky ? '، والسماء ' + state.sky : ''}.`,
        `الرطوبة <b dir="ltr">${h}%</b>، ${humWord(h)}، ونحس بالحرارة وكأنها <b dir="ltr">${feel}${u}</b>.`,
        `الرياح ${dir} ${windWord(state.windSpeed)}، سرعتها <b><span dir="ltr">${ws}</span> كم/س</b>.`,
        `نصيحتي لكم: ${advice}`
      ];
      let seasonLine = '';
      try{ if(currentSeason) seasonLine = `نحن الآن في فصل <b>${currentSeason.name}</b>`; }catch(e){}
      const an = currentAnwaa();
      if(an) seasonLine += (seasonLine ? '، و' : '') + `النوء الحالي <b>${an.name}</b>`;
      if(seasonLine) out.push(seasonLine + '.');

      wxEl.textContent = wxIcon(c, h);
      cityEl.textContent = city + ' · مباشر';
      return out;
    }

    function drawDots(){
      dotsEl.innerHTML = lines.map((_, i) => `<span class="${i === idx ? 'on' : ''}"></span>`).join('');
    }
    function talkBlip(){
      if(speaking) return;
      card.classList.add('talking');
      setTimeout(() => { if(!speaking) card.classList.remove('talking'); }, 1100);
    }
    function show(i, animate){
      lines = build();
      idx = ((i % lines.length) + lines.length) % lines.length;
      if(animate){
        textEl.classList.add('fade');
        setTimeout(() => { textEl.innerHTML = lines[idx]; textEl.classList.remove('fade'); talkBlip(); }, 220);
      } else {
        textEl.innerHTML = lines[idx];
      }
      drawDots();
    }
    function next(){ show(idx + 1, true); restartAuto(); }
    function restartAuto(){
      clearInterval(autoTimer);
      autoTimer = setInterval(() => { if(!speaking) show(idx + 1, true); }, 7000);
    }

    // refresh the current sentence whenever the numbers change
    const baseRender = render;
    render = function(){ baseRender(); if(lines.length) show(idx, false); };

    // ---- voice ----
    function toSpeech(html){
      return html.replace(/<[^>]+>/g, '')
        .replace(/°F/g, ' درجة فهرنهايت').replace(/°/g, ' درجة')
        .replace(/%/g, ' بالمئة').replace(/كم\/س/g, 'كيلومتر في الساعة').replace(/·/g, '،');
    }
    const FEMALE = /laila|layla|mariam|maryam|amira|hoda|huda|salma|zariyah|fatima|noura|nora|reem|sana|mona|lana|female|woman|أنثى/i;
    const MALE = /maged|majed|tarik|tariq|naayf|hamed|shakir|omar|male|man\b/i;
    let voicesCache = [];
    function loadVoices(){ if(window.speechSynthesis) voicesCache = speechSynthesis.getVoices(); }
    loadVoices();
    if(window.speechSynthesis) speechSynthesis.onvoiceschanged = loadVoices;
    // returns {voice, female}
    function arabicVoice(){
      if(!voicesCache.length) loadVoices();
      const ar = voicesCache.filter(v => /^ar/i.test(v.lang));
      const fem = ar.find(v => FEMALE.test(v.name) && !/\bmale\b/i.test(v.name));
      if(fem) return { voice: fem, female: true };
      const notMale = ar.find(v => !MALE.test(v.name));
      if(notMale) return { voice: notMale, female: false };
      return { voice: ar[0] || null, female: false };
    }

    function stopSpeaking(){
      if(window.speechSynthesis) speechSynthesis.cancel();
      speaking = false;
      card.classList.remove('talking');
      speakLbl.textContent = 'اسمع النشرة';
    }
    function speakAll(){
      if(!('speechSynthesis' in window)){ showToast('المتصفح لا يدعم القراءة الصوتية'); return; }
      if(speaking){ stopSpeaking(); return; }
      lines = build();
      const picked = arabicVoice();
      const voice = picked.voice;
      if(!voice) showToast('لا يوجد صوت عربي على هذا الجهاز، سيُستخدم الصوت الافتراضي');
      speechSynthesis.cancel();
      speaking = true;
      card.classList.add('talking');
      speakLbl.textContent = 'إيقاف';
      lines.forEach((line, i) => {
        const u = new SpeechSynthesisUtterance(toSpeech(line));
        u.lang = voice ? voice.lang : 'ar-SA';
        if(voice) u.voice = voice;
        // if no female Arabic voice is installed, raise the pitch so it sounds like a young woman
        u.rate = 0.95; u.pitch = picked.female ? 1.1 : 1.6;
        u.onstart = () => { idx = i; textEl.innerHTML = lines[i]; drawDots(); };
        if(i === lines.length - 1){ u.onend = stopSpeaking; u.onerror = stopSpeaking; }
        speechSynthesis.speak(u);
      });
    }

    speakBtn.addEventListener('click', speakAll);
    document.getElementById('muznaNext').addEventListener('click', next);
    const avatar = document.getElementById('muznaAvatar');
    avatar.addEventListener('click', speakAll);
    avatar.addEventListener('keydown', e => { if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); speakAll(); } });

    setTimeout(() => { show(0, false); talkBlip(); restartAuto(); }, 300);
  })();


