        const s = Math.max(0, Math.floor(ms/1000));
        el.querySelector('.d').textContent = Math.floor(s/86400);
        el.querySelector('.h').textContent = pad(Math.floor(s%86400/3600));
        el.querySelector('.m').textContent = pad(Math.floor(s%3600/60));
        el.querySelector('.s').textContent = pad(s%60);
