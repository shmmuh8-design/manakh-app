        const big = a % 30 === 0, r1 = big ? 104 : 110, r2 = 117;
        const x1 = c + r1 * Math.sin(rad(a)), y1 = c - r1 * Math.cos(rad(a));
        const x2 = c + r2 * Math.sin(rad(a)), y2 = c - r2 * Math.cos(rad(a));
        h += `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="${big ? 'rgba(255,255,255,.55)' : 'rgba(255,255,255,.18)'}" stroke-width="${big ? 2 : 1}"/>`;
      }
      [['ش',0,'#ff6a3d'],['ق',90,'#eef2f8'],['ج',180,'#eef2f8'],['غ',270,'#eef2f8']].forEach(([t,a,col]) => {
        const x = c + 88 * Math.sin(rad(a)), y = c - 88 * Math.cos(rad(a));
        h += `<text x="${x.toFixed(1)}" y="${(y + 7).toFixed(1)}" text-anchor="middle" font-size="20" font-weight="700" fill="${col}" font-family="IBM Plex Sans Arabic, sans-serif">${t}</text>`;
      });
      svg.innerHTML = h;
    })();

    let qLoc = null, qBearing = 0, qiblaUsingCity = true;
    let heading = null, shown = 0, rafOn = false, lastAligned = false, gotAbsolute = false, listening = false, sensorSeen = false;

    function setQiblaLoc(p, fromGps){
      qLoc = p; qiblaUsingCity = !fromGps;
      qBearing = qiblaBearing(p.lat, p.lon);
      $('qiblaArm').style.transform = `rotateZ(${qBearing}deg)`;
      $('qiblaDeg').textContent = Math.round(qBearing) + '°';
      $('qiblaDist').textContent = Math.round(distKm(p.lat, p.lon)).toLocaleString('en-US');
      $('qiblaSrc').textContent = 'الموقع: ' + p.label + (fromGps ? ' (GPS)' : ' — للدقة اضغط «موقعي الدقيق»');
