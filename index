  let prayerSunriseMin = 6 * 60, prayerDayKey = '', prayerTomorrowFajr = 0, prayerCityInfo = null;

  const pdr = d => d * Math.PI / 180, prd = r => r * 180 / Math.PI;
  const pSin = d => Math.sin(pdr(d)), pCos = d => Math.cos(pdr(d)), pTan = d => Math.tan(pdr(d));
  const pAsin = x => prd(Math.asin(x)), pAcos = x => prd(Math.acos(x)), pAtan2 = (y, x) => prd(Math.atan2(y, x));
  const pFix = (a, b) => { a = a - b * Math.floor(a / b); return a < 0 ? a + b : a; };
  function pJulian(y, m, d){
    if(m <= 2){ y -= 1; m += 12; }
    const A = Math.floor(y / 100), B = 2 - A + Math.floor(A / 4);
    return Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + d + B - 1524.5;
  }
  function pSun(jd){
    const D = jd - 2451545.0, g = pFix(357.529 + 0.98560028 * D, 360), q = pFix(280.459 + 0.98564736 * D, 360);
    const L = pFix(q + 1.915 * pSin(g) + 0.020 * pSin(2 * g), 360), e = 23.439 - 0.00000036 * D;
    const RA = pFix(pAtan2(pCos(e) * pSin(L), pCos(L)) / 15, 24);
    return { decl: pAsin(pSin(e) * pSin(L)), eqt: q / 15 - RA };
  }
  // offset (hours) of an IANA time zone on a given date
  function pTzOffset(tz, date){
    try{
      const p = {}; new Intl.DateTimeFormat('en-US', { timeZone:tz, hourCycle:'h23', year:'numeric', month:'numeric', day:'numeric', hour:'numeric', minute:'numeric' })
        .formatToParts(date).forEach(x => p[x.type] = x.value);
      const asUTC = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour % 24, +p.minute);
      return Math.round((asUTC - date.getTime()) / 60000) / 60;
    }catch(e){ return -date.getTimezoneOffset() / 60; }
  }
  function pCityNow(tz){
    const p = {}; new Intl.DateTimeFormat('en-US', { timeZone:tz, hourCycle:'h23', year:'numeric', month:'numeric', day:'numeric', hour:'numeric', minute:'numeric', second:'numeric' })
      .formatToParts(new Date()).forEach(x => p[x.type] = x.value);
    return { y:+p.year, mo:+p.month, d:+p.day, min:(+p.hour % 24) * 60 + (+p.minute) + (+p.second) / 60 };
  }
  // returns minutes after local midnight for fajr, sunrise, dhuhr, asr, maghrib, isha
  function pCompute(y, mo, d, lat, lng, tz, method, ramadan){
    const jd = pJulian(y, mo, d) - lng / (15 * 24);
    const mid = t => pFix(12 - pSun(jd + t).eqt, 24);
    const angleT = (ang, t, ccw) => {
      const s = pSun(jd + t), noon = mid(t);
      const T = pAcos((-pSin(ang) - pSin(s.decl) * pSin(lat)) / (pCos(s.decl) * pCos(lat))) / 15;
      return noon + (ccw ? -T : T);
    };
    const asrT = t => { const s = pSun(jd + t); return angleT(-prd(Math.atan(1 / (1 + pTan(Math.abs(lat - s.decl))))), t); };
    let t = { fajr:5, sunrise:6, dhuhr:12, asr:13, sunset:18, isha:18 };
    for(let k = 0; k < 2; k++){
      t = {
        fajr: angleT(method.fajr, t.fajr / 24, true),
        sunrise: angleT(0.833, t.sunrise / 24, true),
        dhuhr: mid(t.dhuhr / 24),
        asr: asrT(t.asr / 24),
        sunset: angleT(0.833, t.sunset / 24),
        isha: method.ishaMin ? 0 : angleT(method.isha, t.isha / 24)
      };
    }
    if(method.ishaMin) t.isha = t.sunset + (method.ishaMin + (ramadan ? 30 : 0)) / 60;
    // high latitudes: if twilight never ends, use the angle-based share of the night
    const night = pFix(t.sunrise - t.sunset, 24);
    if(isNaN(t.fajr) || pFix(t.sunrise - t.fajr, 24) > method.fajr / 60 * night) t.fajr = t.sunrise - method.fajr / 60 * night;
    if(!method.ishaMin && (isNaN(t.isha) || pFix(t.isha - t.sunset, 24) > method.isha / 60 * night)) t.isha = t.sunset + method.isha / 60 * night;
    const adj = tz - lng / 15;
    const toMin = h => Math.round(pFix(h + adj, 24) * 60);
    return { fajr:toMin(t.fajr), sunrise:toMin(t.sunrise), dhuhr:toMin(t.dhuhr + 1 / 60), asr:toMin(t.asr), maghrib:toMin(t.sunset), isha:toMin(t.isha) };
  }
  function pIsRamadan(date){
    try{ return new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { month:'numeric' }).format(date) === '9'; }catch(e){ return false; }
