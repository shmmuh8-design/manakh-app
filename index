<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>مناخ — محطة مناخ للفلك والطقس والطوالع</title>
<meta name="theme-color" content="#0a1120" />
<link rel="apple-touch-icon" href="data:image/png;base64," />
<link rel="icon" type="image/png" href="data:image/png;base64," />
<link rel="manifest" href="data:application/manifest+json;base64," />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="مناخ" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg-deep:#0a1120; --bg-panel:#131d31; --bg-panel-2:#0d1626; --line: rgba(255,255,255,0.07);
    --text-1:#eef2f8; --text-2:#93a0ba; --text-3:#5c6a86;
    --heat-1:#ffb066; --heat-2:#ff6a3d; --cool-1:#79f0d8; --cool-2:#2bb6c9;
    --amber-glow: rgba(255,122,66,.35); --teal-glow: rgba(58,190,190,.32);
  }
  *{box-sizing:border-box;}
  html{ font-size: var(--font-scale, 16px); }
  html,body{height:100%;}
  .ticker-wrap{ overflow:hidden; background:linear-gradient(90deg, rgba(58,190,190,.18), rgba(255,122,66,.18)); border:1px solid var(--line); border-radius:14px; padding:10px 0; margin-bottom:14px; white-space:nowrap; }
  .ticker-track{ display:inline-flex; gap:60px; animation:tickerScroll 16s linear infinite; will-change:transform; }
  .ticker-track span{ font-size:1rem; font-weight:700; color:var(--cool-1); padding-inline-start:60px; }
  @keyframes tickerScroll{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }
  body{
    margin:0; min-height:100dvh; background:var(--bg-deep); color:var(--text-1);
    font-family:"IBM Plex Sans Arabic","Sora",sans-serif;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
    position:relative; overflow-x:hidden;
  }
  body::before,body::after{ content:""; position:fixed; width:60vmax;height:60vmax; border-radius:50%; filter:blur(90px); opacity:.22; z-index:0; pointer-events:none; }
  body::before{ background:var(--heat-2); top:-20vmax; inset-inline-end:-20vmax; }
  body::after{ background:var(--cool-2); bottom:-24vmax; inset-inline-start:-22vmax; }

  .app{ position:relative; z-index:1; max-width:460px; margin:0 auto; padding:18px 16px 108px; }

  .page{ display:none; }
  .page.active{ display:block; animation:fadeIn .35s ease; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  /* ---------- 3D glossy icon tiles ---------- */
  .icon3d{ position:relative; width:44px;height:44px; border-radius:14px; display:flex;align-items:center;justify-content:center; flex-shrink:0;
    box-shadow:0 10px 20px -6px var(--sh, rgba(0,0,0,.45)), inset 0 1px 0 rgba(255,255,255,.3), inset 0 -8px 12px rgba(0,0,0,.28); overflow:hidden; }
  .icon3d::before{ content:""; position:absolute; top:-35%; left:-15%; width:85%;height:75%;
    background:radial-gradient(ellipse at center, rgba(255,255,255,.6), rgba(255,255,255,0) 70%); transform:rotate(-18deg); }
  .icon3d svg{ position:relative; z-index:1; width:22px;height:22px; stroke:#fff; stroke-width:2; fill:none; stroke-linecap:round; stroke-linejoin:round; filter:drop-shadow(0 1px 1px rgba(0,0,0,.4)); }
  .icon3d.sm{ width:34px;height:34px; border-radius:11px; } .icon3d.sm svg{ width:17px;height:17px; }
  .icon3d.lg{ width:56px;height:56px; border-radius:18px; } .icon3d.lg svg{ width:28px;height:28px; }
  .icon3d.xl{ width:64px;height:64px; border-radius:20px; } .icon3d.xl svg{ width:32px;height:32px; }

  .icon3d.amber{ background:linear-gradient(150deg,#ffb066,#ff6a3d 70%); --sh:rgba(255,122,66,.45); }
  .icon3d.teal{ background:linear-gradient(150deg,#7af0da,#219aae 70%); --sh:rgba(45,180,190,.45); }
  .icon3d.blue{ background:linear-gradient(150deg,#8db8ff,#3d64d8 70%); --sh:rgba(70,105,225,.4); }
  .icon3d.violet{ background:linear-gradient(150deg,#cfa4ff,#7a4fe0 70%); --sh:rgba(130,90,220,.4); }
  .icon3d.green{ background:linear-gradient(150deg,#9bf0b8,#2fbf6f 70%); --sh:rgba(50,190,110,.4); }
  .icon3d.slate{ background:linear-gradient(150deg,#8b98b6,#3c485f 70%); --sh:rgba(20,26,38,.5); }
  .icon3d.gold{ background:linear-gradient(150deg,#ffe08a,#f2a53c 70%); --sh:rgba(240,175,60,.4); }
  .icon3d.ice{ background:linear-gradient(150deg,#c8e6ff,#5aa4e0 70%); --sh:rgba(90,160,220,.4); }
  .icon3d.rose{ background:linear-gradient(150deg,#ffb1c8,#e0507f 70%); --sh:rgba(220,80,120,.4); }

  /* ---------- top bar ---------- */
  .topbar{ display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
  .topbar .brand{ display:flex; align-items:center; gap:10px; }
  .brand-name{ font-family:"IBM Plex Sans Arabic","Sora",sans-serif; font-weight:700; font-size:1.3rem; line-height:1.2; text-align:center;}
  .brand-sub{ font-size:.72rem; color:var(--text-3); margin-top:1px; text-align:center;}
  .icon-btn{ background:transparent; border:none; padding:0; cursor:pointer; }
  .bell-wrap{ position:relative; }
  .badge{ position:absolute; top:-3px; inset-inline-end:-3px; background:var(--heat-2); color:#fff; font-size:.62rem; font-weight:700;
    min-width:16px; height:16px; border-radius:999px; display:flex; align-items:center; justify-content:center; border:2px solid var(--bg-deep); }

  .greeting{ margin-bottom:16px; text-align:center; }
  .greeting-title{ font-size:1.28rem; font-weight:800; line-height:1.55; margin:0 0 10px; color:var(--text-1); }
  .greeting-day{ margin:0 0 2px; font-size:.95rem; font-weight:700; color:var(--text-1); }
  .greeting-date{ margin:0; font-size:.8rem; color:var(--text-3); }

  .city-pill{ display:inline-flex; align-items:center; gap:8px; background:var(--bg-panel); border:1px solid var(--line); padding:7px 8px 7px 14px; border-radius:999px; margin-bottom:20px; cursor:pointer; user-select:none; }
  .city-pill span{ font-size:.85rem; font-weight:600; } .city-pill svg.chev{ width:14px;height:14px; stroke:var(--text-2); stroke-width:2.4; fill:none; margin-inline-start:2px; }

  .back-row{ display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  .back-row h1{ font-size:1.15rem; margin:0; font-weight:700; }
  .back-btn{ background:var(--bg-panel); border:1px solid var(--line); width:38px;height:38px;border-radius:12px; display:flex;align-items:center;justify-content:center; cursor:pointer; }
  .back-btn svg{ width:18px;height:18px; stroke:var(--text-1); stroke-width:2.2; fill:none; }

  /* ---------- hero gauges ---------- */
  .hero{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px; }
  .hero-card{ border-radius:26px; padding:18px 14px; background:linear-gradient(180deg,var(--bg-panel),var(--bg-panel-2)); border:1px solid var(--line); display:flex; flex-direction:column; align-items:center; text-align:center; }
  .hero-card.indoor{ box-shadow:0 24px 40px -26px var(--teal-glow); } .hero-card.outdoor{ box-shadow:0 24px 40px -26px var(--amber-glow); }
  .hero-label{ display:flex; align-items:center; gap:8px; align-self:flex-start; margin-bottom:10px; } .hero-label span{ font-size:.82rem; font-weight:600; color:var(--text-2); }
  .gauge{ position:relative; width:120px; height:120px; margin:2px 0 8px; } .gauge svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .gauge.big{ width:150px;height:150px; }
  .gauge .track{ fill:none; stroke:rgba(255,255,255,.06); stroke-width:10; } .gauge .val{ fill:none; stroke-width:10; stroke-linecap:round; transition:stroke-dashoffset 1.1s cubic-bezier(.22,1,.36,1); }
  .gauge-center{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .gauge-center .num{ font-family:"Sora",sans-serif; font-size:1.9rem; font-weight:700; line-height:1; } .gauge-center .num.big{ font-size:2.4rem; }
  .gauge-center .num sup{ font-size:1rem; font-weight:600; } .gauge-center .sub{ font-size:.68rem; color:var(--text-3); margin-top:4px; }
  .trend{ display:flex; align-items:center; gap:5px; font-size:.74rem; color:var(--text-2); } .trend svg{ width:12px;height:12px; stroke-width:3; }
  .trend.up svg{ stroke:var(--heat-1); } .trend.down svg{ stroke:var(--cool-1); }

  /* ---------- generic card ---------- */
  .card{ background:linear-gradient(180deg,var(--bg-panel),var(--bg-panel-2)); border:1px solid var(--line); border-radius:20px; padding:16px; margin-bottom:12px; }
  .card-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; } .card-head h2{ font-size:.92rem; margin:0; font-weight:700; }
  .chip{ font-size:.7rem; font-weight:700; padding:4px 10px; border-radius:999px; } .chip.good{ background:rgba(90,220,150,.15); color:#7be8ab; }
  .chip.live{ display:flex; align-items:center; gap:5px; color:var(--text-2); font-weight:600; }
  .dot-live{ width:7px;height:7px; border-radius:50%; background:#ff5a52; animation:pulse 1.6s infinite; }
  @keyframes pulse{ 0%{box-shadow:0 0 0 0 rgba(255,90,82,.55);} 70%{box-shadow:0 0 0 8px rgba(255,90,82,0);} 100%{box-shadow:0 0 0 0 rgba(255,90,82,0);} }

  .comfort-track{ position:relative; height:12px; border-radius:999px; background:linear-gradient(90deg,var(--cool-2),var(--cool-1) 35%, #ffd88a 55%, var(--heat-1) 75%, var(--heat-2)); margin:14px 2px 8px; }
  .comfort-zone{ position:absolute; top:-4px; bottom:-4px; border:2px dashed rgba(255,255,255,.5); border-radius:999px; }
  .comfort-marker{ position:absolute; top:50%; width:20px;height:20px; border-radius:50%; background:#fff; box-shadow:0 3px 8px rgba(0,0,0,.4),0 0 0 4px var(--bg-panel); transform:translate(50%,-50%); transition:right 1s ease; }
  .comfort-caption{ font-size:.78rem; color:var(--text-2); margin-top:10px; }

  .twoup{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .stat-card{ display:flex; align-items:center; gap:12px; } .stat-card .num{ font-family:"Sora",sans-serif; font-weight:700; font-size:1.35rem; } .stat-card .lbl{ font-size:.72rem; color:var(--text-2); margin-top:1px; }

  .chart-wrap{ position:relative; height:130px; } .chart-wrap svg{ width:100%; height:100%; overflow:visible; }
  .axis-labels{ display:flex; justify-content:space-between; margin-top:6px; } .axis-labels span{ font-size:.66rem; color:var(--text-3); }
  .legend{ display:flex; gap:14px; margin-top:10px; } .legend span{ font-size:.72rem; color:var(--text-2); display:flex; align-items:center; gap:6px; } .legend i{ width:9px;height:9px;border-radius:50%; display:inline-block; }

  .alert-row{ display:flex; align-items:center; gap:12px; padding:9px 0; border-top:1px solid var(--line); } .alert-row:first-child{ border-top:none; padding-top:2px; }
  .alert-row .txt{ flex:1; } .alert-row .txt p{ margin:0; font-size:.84rem; font-weight:500; } .alert-row .txt time{ font-size:.7rem; color:var(--text-3); }
  .link-btn{ background:none;border:none;color:var(--cool-1); font-size:.78rem; font-weight:600; cursor:pointer; padding:0; font-family:inherit; }

  .sensor-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  .sensor-chip{ background:var(--bg-panel-2); border:1px solid var(--line); border-radius:16px; padding:12px 8px; text-align:center; }
  .sensor-chip .icon3d{ margin:0 auto 8px; } .sensor-chip p{ margin:0; font-size:.72rem; font-weight:600; }
  .sensor-chip .status{ display:flex; align-items:center; justify-content:center; gap:5px; margin-top:5px; } .sensor-chip .status i{ width:6px;height:6px;border-radius:50%; background:#4ee08a; } .sensor-chip .status span{ font-size:.64rem; color:var(--text-3); }

  .footnote{ text-align:center; color:var(--text-3); font-size:.72rem; margin:6px 0 4px; }

  .toast{ position:fixed; bottom:96px; inset-inline-start:50%; transform:translateX(-50%) translateY(20px); background:rgba(19,29,49,.95); backdrop-filter:blur(10px); border:1px solid var(--line); color:var(--text-1); font-size:.82rem; font-weight:600; padding:12px 20px; border-radius:14px; box-shadow:0 12px 30px rgba(0,0,0,.5); z-index:20; opacity:0; pointer-events:none; transition:opacity .25s ease, transform .25s ease; max-width:88%; text-align:center; }
  [dir="rtl"] .toast{ transform:translateX(50%) translateY(20px); }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
  [dir="rtl"] .toast.show{ transform:translateX(50%) translateY(0); }

  .alert-banner{ position:fixed; top:calc(env(safe-area-inset-top,0px) + 12px); inset-inline-start:14px; inset-inline-end:14px; z-index:30; background:linear-gradient(135deg,#ff8a4c,#ff4d4d); border-radius:18px; padding:14px 16px; display:flex; align-items:center; gap:12px; box-shadow:0 16px 40px rgba(255,90,60,.4); transform:translateY(-140%); opacity:0; transition:transform .35s cubic-bezier(.22,1,.36,1), opacity .35s ease; cursor:pointer; max-width:460px; margin:0 auto; }
  .alert-banner.show{ transform:translateY(0); opacity:1; }
  .alert-banner .ab-icon{ font-size:1.6rem; flex-shrink:0; }
  .alert-banner .ab-title{ font-weight:700; font-size:.92rem; color:#fff; }
  .alert-banner .ab-msg{ font-size:.78rem; color:rgba(255,255,255,.9); margin-top:2px; }
  .toggle{ width:44px;height:26px; border-radius:999px; background:rgba(255,255,255,.12); position:relative; flex-shrink:0; transition:background .2s ease; }
  .toggle::after{ content:""; position:absolute; top:3px; inset-inline-start:3px; width:20px;height:20px; border-radius:50%; background:#fff; transition:inset-inline-start .2s ease; box-shadow:0 2px 6px rgba(0,0,0,.3); }
  .toggle.on{ background:var(--cool-2); } .toggle.on::after{ inset-inline-start:21px; }

  /* season entry card on Home */
  .season-entry{ display:flex; align-items:center; gap:14px; cursor:pointer; }
  .season-entry .zodiac-row{ display:flex; gap:6px; margin-top:6px; }
  .zchip{ width:26px;height:26px; border-radius:8px; background:linear-gradient(150deg,#cfa4ff,#7a4fe0 70%); display:flex;align-items:center;justify-content:center; font-size:.85rem; color:#fff; }
  .season-entry .arrow{ margin-inline-start:auto; }
  .season-entry .arrow svg{ width:16px;height:16px; stroke:var(--text-3); stroke-width:2.2; fill:none; transform:scaleX(-1); }

  /* weather tab: thermometer gauges row already reuses .hero, plus wind compass */
  .compass-wrap{ display:flex; flex-direction:column; align-items:center; }
  .compass{ position:relative; width:220px; height:220px; margin:6px 0 14px; }
  .compass svg{ width:100%; height:100%; }
  .compass-dirs span{ position:absolute; font-size:.75rem; font-weight:700; color:var(--text-2); }
  .compass-center{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .compass-center .num{ font-family:"Sora",sans-serif; font-weight:700; font-size:1.7rem; } .compass-center .lbl{ font-size:.68rem; color:var(--text-3); }
  .wind-row{ display:flex; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line); }
  .wind-row:first-child{ border-top:none; }
  .wind-row .name{ flex:1; font-size:.84rem; font-weight:600; }
  .wind-row .meta{ font-size:.72rem; color:var(--text-3); }
  .wind-arrow{ width:30px;height:30px; border-radius:50%; background:var(--bg-panel-2); border:1px solid var(--line); display:flex;align-items:center;justify-content:center; }
  .wind-arrow svg{ width:14px;height:14px; stroke:var(--cool-1); stroke-width:2.4; fill:none; }

  .uv-row{ display:flex; align-items:center; gap:16px; }
  .uv-badge{ width:56px;height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-family:"Sora",sans-serif; font-weight:700; font-size:1.4rem; color:#04231a; flex-shrink:0; }
  .uv-text{ flex:1; }
  .uv-level{ font-weight:700; font-size:.92rem; margin-bottom:3px; }
  .uv-desc{ font-size:.78rem; color:var(--text-2); }

  .wind-row2{ padding:12px 0; border-top:1px solid var(--line); }
  .wind-row2:first-child{ border-top:none; }
  .wr2-top{ display:flex; align-items:center; gap:10px; }
  .wr2-bell{ width:30px;height:30px; border-radius:50%; background:var(--bg-panel-2); border:1px solid var(--line); display:flex;align-items:center;justify-content:center; flex-shrink:0; cursor:pointer; }
  .wr2-bell svg{ width:14px;height:14px; stroke:var(--text-3); stroke-width:2.2; fill:none; }
  .wr2-bell.on svg{ stroke:var(--cool-1); }
  .wr2-meta{ font-size:.72rem; color:var(--text-3); flex:1; }
  .wr2-name{ font-size:.86rem; font-weight:700; }
  .wr2-bottom{ display:flex; align-items:center; justify-content:space-between; margin-top:10px; }
  .interval-chips{ display:flex; gap:6px; }
  .chip-btn{ padding:4px 11px; border-radius:999px; background:var(--bg-panel-2); border:1px solid var(--line); font-size:.7rem; color:var(--text-2); cursor:pointer; font-family:inherit; }
  .chip-btn.active{ background:var(--cool-2); color:#04202a; font-weight:700; border-color:transparent; }
  .interval-label{ font-size:.7rem; color:var(--text-3); }

  .star-hour-row{ display:flex; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line); }
  .star-hour-row:first-child{ border-top:none; }
  .star-hour-row.cur{ background:rgba(255,140,80,.08); border-radius:12px; padding-inline:8px; margin-inline:-8px; }
  .star-hour-row .sh-time{ font-size:.72rem; color:var(--text-3); width:88px; flex-shrink:0; }
  .star-hour-row .sh-name{ font-weight:700; font-size:.86rem; }
  .star-hour-row .sh-props{ font-size:.72rem; color:var(--text-2); margin-top:2px; }
  .star-hour-row .sh-badge{ margin-inline-start:auto; font-size:.66rem; font-weight:700; padding:3px 9px; border-radius:999px; background:rgba(255,140,80,.18); color:var(--heat-1); flex-shrink:0; }

  .zg-row{ display:flex; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line); }
  .zg-row:first-child{ border-top:none; }
  .zg-row.cur{ background:rgba(255,140,80,.08); border-radius:12px; padding-inline:8px; margin-inline:-8px; }
  .zg-row .zg-sym{ width:38px;height:38px; border-radius:12px; background:linear-gradient(150deg,#cfa4ff,#7a4fe0 70%); display:flex;align-items:center;justify-content:center; font-size:1.1rem; color:#fff; flex-shrink:0; }
  .zg-row .zg-name{ font-weight:700; font-size:.88rem; }
  .zg-row .zg-range{ font-size:.72rem; color:var(--text-3); margin-top:2px; }
  .zg-row .zg-days{ margin-inline-start:auto; font-size:.66rem; font-weight:700; padding:3px 9px; border-radius:999px; background:rgba(255,140,80,.18); color:var(--heat-1); flex-shrink:0; white-space:nowrap; }

  .anwaa-hero-card{ border-radius:24px; padding:20px 18px; background:linear-gradient(180deg,var(--bg-panel),var(--bg-panel-2)); border:1px solid var(--line); text-align:center; margin-bottom:14px; box-shadow:0 24px 40px -28px var(--amber-glow); }
  .anwaa-pill{ display:inline-block; background:rgba(255,140,80,.16); color:var(--heat-1); font-size:.72rem; font-weight:700; padding:5px 14px; border-radius:999px; margin-bottom:14px; }
  .anwaa-badges{ display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:10px; }
  .anwaa-idx{ width:34px;height:34px; border-radius:50%; border:2px solid var(--heat-1); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:.82rem; color:var(--heat-1); }
  .anwaa-season-chip{ font-size:.72rem; font-weight:700; padding:4px 12px; border-radius:999px; background:rgba(120,90,220,.18); color:#cfa4ff; }
  .anwaa-name{ font-size:1.6rem; font-weight:700; margin-bottom:2px; }
  .anwaa-translit{ font-size:.8rem; color:var(--text-3); margin-bottom:14px; }
  .anwaa-progress{ height:7px; border-radius:999px; background:rgba(255,255,255,.08); overflow:hidden; margin:0 2px 10px; }
  .anwaa-progress-fill{ height:100%; background:linear-gradient(90deg,var(--cool-2),var(--heat-1)); border-radius:999px; transition:width .6s ease; }
  .anwaa-daycount{ font-size:.78rem; color:var(--text-2); }
  .anwaa-stats{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px; }
  .anwaa-stat{ background:var(--bg-panel-2); border:1px solid var(--line); border-radius:14px; padding:11px 10px; text-align:center; }
  .anwaa-stat.wide{ grid-column:1 / -1; }
  .anwaa-stat .lbl{ font-size:.68rem; color:var(--text-3); margin-bottom:4px; }
  .anwaa-stat .val{ font-weight:700; font-size:.9rem; }
  .anwaa-section{ text-align:right; margin-top:4px; }
