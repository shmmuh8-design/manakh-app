    }
    function paintQibla(){
      const h = heading === null ? 0 : shown;
      $('qiblaDial').style.transform = `rotateZ(${-h}deg)`;
      if(heading === null) return;
      const hm = ((h % 360) + 360) % 360;
      $('qiblaHeading').textContent = Math.round(hm) + '°';
